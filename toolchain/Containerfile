ARG VERSION=5.8.203
ARG DEVICE=rm1
FROM eeems/remarkable-toolchain:${VERSION}-${DEVICE}

ARG ENVIRONMENT_SETUP
ENV ENVIRONMENT_SETUP=${ENVIRONMENT_SETUP}

ARG ZIG_TARGET=arm-linux-gnueabihf
ENV ZIG_TARGET=$ZIG_TARGET
RUN <<EOT
  set -e
  apt-get update
  apt-get install -y --no-install-recommends clang-format
  curl -fsSL -o /tmp/zig.tar.xz \
    https://ziglang.org/download/0.17.0/zig-x86_64-linux-0.17.0.tar.xz
  tar -xf /tmp/zig.tar.xz -C /opt
  ln -s /opt/zig-x86_64-linux-0.17.0/zig /usr/local/bin/zig
  apt-get clean
  rm -rf \
    /var/lib/apt/lists/* \
    /tmp/zig.tar.xz
EOT
